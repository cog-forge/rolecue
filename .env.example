DB_DATABASE=rolecue
DB_USERNAME=postgres
DB_PASSWORD=local-password
DB_PORT=5434
DATABASE_URL=postgres://postgres:local-password@localhost:5434/rolecue?sslmode=disable


LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite
LLM_TIMEOUT=30s
LLM_MAX_RETRIES=1

# Core questions generated per question bank (team decision: 50). 0 disables generation.
QUESTION_BANK_SIZE=50

SERVER_PORT=8080
CORS_ALLOW_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_COOKIE_PREFIX=rolecue
BETTER_AUTH_COOKIE_DOMAIN=
AUTH_SECURE_COOKIES=false
AUTH_SESSION_TIMEOUT=5s
