DB_DATABASE=rolecue
DB_USERNAME=postgres
DB_PASSWORD=local-password
DB_PORT=5432
DATABASE_URL=postgres://postgres:local-password@localhost:5432/rolecue?sslmode=disable
# Production refuses postgres/postgres, an empty password or a missing database URL. Set
# DATABASE_REQUIRE_TLS=true to also require sslmode=verify-full with sslrootcert=<CA file> in the URL
# (or DATABASE_SSL_ROOT_CERT when using the DB_* settings).
DATABASE_REQUIRE_TLS=false

# Required at Go API startup on main. Obtain these three keys from PayOS.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# S3-compatible storage (Bizfly HCM example). Credentials stay server-side.
S3_ENDPOINT=https://hcm.ss.bfcplatform.vn
S3_REGION=hcm
S3_BUCKET=role-cue
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SESSION_TOKEN=

# KAN-122: installed Blender 5.2 + VRM extension 4.10.2 for the API service user.
# Existing inventory reads work with conversion disabled. No MCP/GUI required.
AVATAR_CONVERSION_ENABLED=false
AVATAR_BLENDER_BINARY=blender
AVATAR_CONVERSION_TIMEOUT=120s
AVATAR_MAX_INPUT_BYTES=52428800
AVATAR_MAX_OUTPUT_BYTES=104857600
# Required when enabling: choose source-authorized usage and source license URL.
AVATAR_VRM_COMMERCIAL_USAGE=
AVATAR_VRM_LICENSE_URL=

LLM_PROVIDER=gemini
# Required at Go API startup. Gemini API key; used by JD/question-bank services.
LLM_API_KEY=
LLM_MODEL=gemini-3.1-flash-lite
LLM_TIMEOUT=30s
LLM_MAX_RETRIES=1
# Upper bound on the tokens of one LLM completion (cost cap). 0 = provider default.
LLM_MAX_OUTPUT_TOKENS=4096

# Azure AI Speech: text-to-speech for the interviewer and the Admin voice sync. Optional: without both
# values the API still starts, interviews fall back to showing questions as text and the voice sync
# reports the provider as not configured. Free tier is 500K characters per month.
# An API built with `-tags azure_sdk` uses the Speech SDK and adds visemes, blend shapes and word timings
# (api/docs/azure-speech-sdk-spike.md). Keep its CGO_* and LD_LIBRARY_PATH settings out of this file.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=koreacentral
# Budget for one provider call, retries included.
TTS_TIMEOUT=10s
# The voice sync keeps only these locales. The interview speaks English only, so the default is en-US
# ("en" would also match en-GB and so on; empty keeps every locale).
# Whatever the locale, the sync keeps standard neural voices only: HD and multilingual voices are left out.
TTS_SYNC_LOCALES=en-US

# Transactional email sent by the Go API (KAN-213). "log" only logs; "resend" sends through Resend and
# needs RESEND_API_KEY and EMAIL_FROM (the auth service has its own Resend settings).
EMAIL_PROVIDER=log
EMAIL_FROM=
RESEND_API_KEY=
EMAIL_TIMEOUT=10s
EMAIL_WORKERS=2
EMAIL_QUEUE_SIZE=256
EMAIL_MAX_ATTEMPTS=3
EMAIL_BACKOFF=1s
# Published Resend template IDs (or aliases), required for moderation when EMAIL_PROVIDER=resend.
EMAIL_MODERATION_APPROVED_TEMPLATE_ID=
EMAIL_MODERATION_REJECTED_TEMPLATE_ID=
# Resend templates for Application emails (KAN-219). A blank one disables that notice.
EMAIL_APPLICATION_SUBMITTED_TEMPLATE_ID=
EMAIL_APPLICATION_NEW_APPLICATION_TEMPLATE_ID=
EMAIL_APPLICATION_CV_REJECTED_TEMPLATE_ID=
EMAIL_APPLICATION_CV_APPROVED_TEMPLATE_ID=
EMAIL_APPLICATION_DECISION_APPROVED_TEMPLATE_ID=
EMAIL_APPLICATION_DECISION_REJECTED_TEMPLATE_ID=
EMAIL_APPLICATION_AUTO_REJECTED_TEMPLATE_ID=
EMAIL_APPLICATION_INTAKE_CLOSED_TEMPLATE_ID=

# Core questions generated per question bank (team decision: 50). 0 disables generation.
QUESTION_BANK_SIZE=50

# A Job Posting's evaluation weights must add up to this total. 0 turns the sum check off.
EVALUATION_WEIGHT_TOTAL=100

# Live interview WebSocket guards. The login behind an open socket is re-verified this often (5s-10m) and
# the socket closes once it is gone (logout, ban, password reset). Incoming messages per socket use a token
# bucket: LIVE_MESSAGE_RATE per second with LIVE_MESSAGE_BURST at once; a flood is throttled, then closed.
INTERVIEW_LIVE_RECHECK_INTERVAL=60s
INTERVIEW_LIVE_MESSAGE_RATE=20
INTERVIEW_LIVE_MESSAGE_BURST=60

SERVER_PORT=8080
# Comma-separated IPs/CIDRs of the reverse proxies whose X-Forwarded-For the API believes (client IP in
# access logs). Default is loopback only. Behind Caddy/a load balancer, set its address or network.
SERVER_TRUSTED_PROXIES=127.0.0.1,::1
CORS_ALLOW_ORIGINS=http://localhost:3000
CORS_ALLOW_CREDENTIALS=true

AUTH_UPSTREAM_URL=http://localhost:3001
AUTH_BASE_URL=http://localhost:3000
# Legacy BETTER_AUTH_URL is used only when AUTH_UPSTREAM_URL is absent.
BETTER_AUTH_COOKIE_PREFIX=rolecue
BETTER_AUTH_COOKIE_DOMAIN=
AUTH_SECURE_COOKIES=false
AUTH_SESSION_TIMEOUT=5s

# Same random secret (32+ characters) in root and auth/.env.
# Permits Go to invoke Better Auth admin plugin writes; never NEXT_PUBLIC_.
ADMIN_AUTH_INTERNAL_SECRET=

# Most core questions one interview session asks (0 uses the default of 8, maximum 20).
# The practice interview price is fixed at 5 coins in code, not configured here.
# INTERVIEW_QUESTION_LIMIT=8
# Most follow-up questions the live interviewer asks after one core question (0 turns follow-ups off,
# maximum 3), and the bound of one follow-up decision (1s to 15s); after it the next core question follows.
# INTERVIEW_FOLLOW_UP_LIMIT=1
# INTERVIEW_FOLLOW_UP_TIMEOUT=5s

# Optional AI task routing. Unset task fields inherit LLM_* (legacy Gemini behavior).
# Groq-first recipe; uncomment per task to enable. Keys come from env only.
GROQ_API_KEY=
# AI_JD_EXTRACTION_PROVIDER=groq
# AI_JD_EXTRACTION_MODEL=openai/gpt-oss-120b
# AI_JD_EXTRACTION_TIMEOUT=30s
# AI_JD_EXTRACTION_MAX_RETRIES=0
# AI_JD_EXTRACTION_FALLBACK=gemini
# AI_QUESTION_BANK_PROVIDER=groq
# AI_QUESTION_BANK_MODEL=openai/gpt-oss-120b
# AI_QUESTION_BANK_TIMEOUT=90s
# AI_QUESTION_BANK_MAX_RETRIES=0
# AI_QUESTION_BANK_FALLBACK=gemini
# AI_FOLLOW_UP_PROVIDER=groq
# AI_FOLLOW_UP_MODEL=openai/gpt-oss-20b
# AI_FOLLOW_UP_TIMEOUT=5s
# AI_FOLLOW_UP_MAX_RETRIES=0
# AI_FOLLOW_UP_FALLBACK=gemini
# AI_EVALUATION_PROVIDER=groq
# AI_EVALUATION_MODEL=openai/gpt-oss-120b
# AI_EVALUATION_TIMEOUT=30s
# AI_EVALUATION_MAX_RETRIES=0
# AI_EVALUATION_FALLBACK=gemini

# System Handler jobs (KAN-174), run inside the API with one PostgreSQL advisory lock per job, so several
# API instances never run the same job at once. JOBS_ENABLED=false switches every job off.
# JOBS_ENABLED=true
# Ends an unfinished interview with no delivered question or stored answer for the timeout (30s to 24h),
# evaluated on what was answered (KAN-180; team decision 2026-11-03: 15 minutes).
# JOBS_ABANDONED_SESSIONS_ENABLED=true
# JOBS_ABANDONED_SESSIONS_INTERVAL=1m
# JOBS_ABANDONED_SESSIONS_TIMEOUT=15m
# Fails a completed recruitment recording still not uploaded after the grace (or still uploading past the
# 15-minute upload grant), so the Recruiter sees "recording failed" (KAN-272).
# JOBS_STALE_RECORDINGS_ENABLED=true
# JOBS_STALE_RECORDINGS_INTERVAL=1m
# JOBS_STALE_RECORDINGS_GRACE=5m
# Deletes recordings 90 days after the Application's final decision (KAN-272; the 90 days is fixed in code).
# JOBS_RECORDING_RETENTION_ENABLED=true
# JOBS_RECORDING_RETENTION_INTERVAL=1h
