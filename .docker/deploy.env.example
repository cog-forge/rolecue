# Copy to .docker/deploy.env (git-ignored) and fill in real values. Never commit deploy.env.
IMAGE_TAG=
APP_URL=
APP_DOMAIN=
API_DOMAIN=
AUTH_BASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_COOKIE_DOMAIN=
ADMIN_AUTH_INTERNAL_SECRET=

DB_DATABASE=rolecue
DB_USERNAME=
DB_PASSWORD=
# Owner/migration connection. Also used by api and auth unless APP_DATABASE_URL is set.
DATABASE_URL=postgres://USER:PASSWORD@postgres:5432/rolecue?sslmode=disable
# Optional least-privilege runtime role for api and auth (see .docker/postgres/roles.sql).
APP_DATABASE_URL=

RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_VERIFY_EMAIL_TEMPLATE_ID=
RESEND_RESET_PASSWORD_TEMPLATE_ID=

PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
LLM_API_KEY=
