{
	admin off
	auto_https off
	# Request error logs can contain OAuth/reset tokens in URLs.
	log default {
		exclude http.log.error
	}
}

:3000 {
	bind 0.0.0.0
	handle /_dev/health {
		respond 200
	}

	# Keep Better Auth same-origin while forwarding to its separate container.
	handle /api/auth/* {
		reverse_proxy auth:3001 {
			header_up -X-RoleCue-Admin-Secret
			header_up -X-RoleCue-Account-Notification
			header_up -Forwarded
			transport http {
				dial_timeout 5s
				response_header_timeout 30s
			}
		}
	}

	handle {
		reverse_proxy frontend:3002
	}

	handle_errors 502 504 {
		header Content-Type application/json
		header Cache-Control no-store
		respond `{"error":"Upstream service unavailable"}` 503
	}
}
