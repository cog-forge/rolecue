# Public browser origins, never the Compose service address.
APP_URL=http://localhost:3000
AUTH_BASE_URL=http://localhost:3000
HOST=127.0.0.1
PORT=3001
# Random stable secret, at least 32 characters; auth service only.
BETTER_AUTH_SECRET=
# Same database as root DATABASE_URL; apply api/migrations before login.
BETTER_AUTH_DATABASE_URL=postgres://postgres:local-password@localhost:5432/rolecue?sslmode=disable

# Must match root BETTER_AUTH_COOKIE_PREFIX; changing it invalidates old cookies.
BETTER_AUTH_COOKIE_PREFIX=rolecue
# Empty on localhost. Production: parent domain of APP_URL/AUTH_BASE_URL and Go.
# Must match root BETTER_AUTH_COOKIE_DOMAIN; HTTPS is required when set.
BETTER_AUTH_COOKIE_DOMAIN=

# Optional: configure a complete pair to enable each social provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Required for verification/reset and account notification mail; auth service only.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_VERIFY_EMAIL_TEMPLATE_ID=
RESEND_RESET_PASSWORD_TEMPLATE_ID=

RESEND_ACCOUNT_LOCKED_TEMPLATE_ID=
RESEND_ACCOUNT_UNLOCKED_TEMPLATE_ID=
SUPPORT_EMAIL=

# Must equal root ADMIN_AUTH_INTERNAL_SECRET; random 32+ characters, server only.
ADMIN_AUTH_INTERNAL_SECRET=
