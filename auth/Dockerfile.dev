FROM oven/bun:1.4.4@sha256:1d22548f177f4ff38e0c15baa3c2c46c6c2060ba2d1bc573bb4720b407548f1d

WORKDIR /app
# compose.local.yaml runs this image as LOCAL_UID:LOCAL_GID and mounts a named volume on
# node_modules; a new volume copies this directory's mode, so it must stay writable for
# any uid. The sticky bit (1777) keeps users from deleting each other's files.
RUN mkdir -p /app/node_modules && chown bun:bun /app /app/node_modules && chmod 1777 /app/node_modules
USER bun
