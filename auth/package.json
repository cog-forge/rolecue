{
  "name": "rolecue-auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "build": "bun build src/server.ts --target=bun --packages=external --outdir=dist",
    "start": "bun dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "better-auth": "1.7.15",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "prettier": "3.9.10",
    "eslint": "9.39.5",
    "typescript-eslint": "8.72.1"
  }
}
