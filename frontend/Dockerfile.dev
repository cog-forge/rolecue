FROM oven/bun:1.4.4@sha256:1d22548f177f4ff38e0c15baa3c2c46c6c2060ba2d1bc573bb4720b407548f1d AS bun
FROM node:24.20.0-trixie-slim@sha256:50c3b2f6988dfc307b86e5301d69611af31f4789bdf232863b07d3b02fe55ae0

COPY --from=bun /usr/local/bin/bun /usr/local/bin/bun
WORKDIR /app
# compose.local.yaml runs this image as LOCAL_UID:LOCAL_GID and mounts a named volume on
# node_modules; a new volume copies this directory's mode, so it must stay writable for
# any uid. The sticky bit (1777) keeps users from deleting each other's files.
RUN mkdir -p /app/node_modules && chown node:node /app /app/node_modules && chmod 1777 /app/node_modules
USER node
