resource "aws_db_subnet_group" "main" {
  name        = local.name
  description = "RoleCue prod database subnets"
  subnet_ids  = aws_subnet.private_db[*].id

  tags = { Name = local.name }
}

# The master password is generated by scripts/prod/gen-secrets.sh and synced to SSM by scripts/prod/sync-secrets.sh.
# An ephemeral read hands it to the write-only password_wo attribute, so it never enters the plan or the state.
ephemeral "aws_ssm_parameter" "rds_master_password" {
  arn             = "arn:aws:ssm:${var.region}:${local.account_id}:parameter${local.ssm_prefix}/RDS_MASTER_PASSWORD"
  with_decryption = true
}

resource "aws_db_instance" "main" {
  identifier = local.name

  engine         = "postgres"
  engine_version = "18.7"
  instance_class = "db.t4g.micro"

  allocated_storage = 20
  storage_type      = "gp3"
  storage_encrypted = true # AWS-managed aws/rds key

  db_name  = "rolecue"
  username = "rolecue_admin"
  port     = 5432

  # Write-only: bump the version to push a new password (after rotating the SSM parameter).
  password_wo         = ephemeral.aws_ssm_parameter.rds_master_password.value
  password_wo_version = 1

  db_subnet_group_name   = aws_db_subnet_group.main.name
  vpc_security_group_ids = [aws_security_group.rds.id]
  publicly_accessible    = false
  multi_az               = false

  # The default parameter group keeps rds.force_ssl on.
  parameter_group_name = "default.postgres18"

  backup_retention_period      = 7
  copy_tags_to_snapshot        = true
  deletion_protection          = true
  skip_final_snapshot          = false
  final_snapshot_identifier    = "${local.name}-final"
  performance_insights_enabled = false
  auto_minor_version_upgrade   = true

  tags = { Name = local.name }

  lifecycle {
    # auto_minor_version_upgrade can move the instance to a newer 18.x on its own; do not plan a downgrade.
    ignore_changes = [engine_version]
  }
}
